local core = require("@imp/core")
local toolchain = require("@imp/rules/imp/toolchain")
local cases = {}
local function ends_with(value, suffix)
	return string.sub(value, -#suffix) == suffix
end

table.insert(cases, core.test.case("@mold selects its final default", function()
	core.test.with_fake_toolchain_host({ os = "linux", arch = "x86_64" }, function()
		local module = require("@imp/rules/c/mold")
		local initial = core.test.resolve(toolchain.resolve("mold"))
		assert(ends_with(initial, "/bin/mold"), initial)
		module.mold_toolchain("2.41.0", { default = true, unverified = true })
		local selected = core.test.resolve(toolchain.resolve("mold"))
		assert(initial ~= selected, selected)
		assert(ends_with(selected, "/bin/mold"), selected)
		assert(string.find(selected, "2.41.0", 1, true), selected)
	end)
end))

