table.insert(cases, core.test.case("@nasm has no default on Linux", function()
	core.test.with_fake_toolchain_host({ os = "linux", arch = "x86_64" }, function()
		require("@imp/rules/c/msvc")
		local ok, message = pcall(toolchain.resolve, "nasm")
		assert(not ok and string.find(tostring(message), "no nasm toolchain version", 1, true), tostring(message))
	end)
end))

return { core.test.suite("CLI toolchain registrations", cases) }
